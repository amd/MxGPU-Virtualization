HOOK_DIR="$(dirname "$0")"
VERSION_CHECK_SCRIPT="$HOOK_DIR/version-check.sh"

if [ -f "$VERSION_CHECK_SCRIPT" ]; then
    exec "$VERSION_CHECK_SCRIPT"
else
    echo "Error: version-check.sh not found at $VERSION_CHECK_SCRIPT"
    exit 1
fi
