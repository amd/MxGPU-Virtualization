root = true

[{*.{cpp,c,h,hpp,mk},Makefile,Makefile.*}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 8

[*.{json,py,rs}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[interface/amdsmi.h]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
