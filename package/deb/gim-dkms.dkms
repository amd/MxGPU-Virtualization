# keep this file in sync with ./package/rpm/dkms.conf !!!
PACKAGE_NAME="gim"
PACKAGE_VERSION="#MODULE_VERSION#"
BUILT_MODULE_NAME[0]="gim"
BUILT_MODULE_LOCATION[0]="./"
DEST_MODULE_LOCATION[0]="/kernel/updates"
BUILT_MODULE_NAME[1]="amd-vfio-pci"
BUILT_MODULE_LOCATION[1]="amd-vfio-pci/"
DEST_MODULE_LOCATION[1]="/kernel/updates"
AUTOINSTALL="yes"
MAKE[0]="make dkms_modules"
PRE_BUILD="./dkms/pre-build.sh --with-linux=$kernel_source_dir"
POST_INSTALL="./dkms/post-install.sh"
POST_REMOVE="./dkms/post-remove.sh"
