# keep this file in sync with ./package/rpm/dkms.conf !!!
PACKAGE_NAME="gim"
PACKAGE_VERSION="#MODULE_VERSION#"
MAKE[0]="make -C gim KERNELDIR=$kernel_source_dir"
BUILT_MODULE_NAME[0]="gim"
BUILT_MODULE_LOCATION[0]="gim"
DEST_MODULE_LOCATION[0]="/kernel/updates"
BUILT_MODULE_NAME[1]="amd-vfio-pci"
BUILT_MODULE_LOCATION[1]="gim/amd-vfio-pci"
DEST_MODULE_LOCATION[1]="/kernel/updates"
AUTOINSTALL="yes"
POST_INSTALL="./gim/dkms/post-install.sh"
POST_REMOVE="./gim/dkms/post-remove.sh"
