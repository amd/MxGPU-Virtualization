#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with dkms

override_dh_install:
	dh_install gim gim-coms-lib libgv smi-lib usr/src/gim-$(DEB_VERSION)/
	echo $(DEB_VERSION) > ./debian/$(DEB_SOURCE)/usr/src/gim-$(DEB_VERSION)/gim/dkms/VERSION

override_dh_dkms:
	dh_dkms -V $(DEB_VERSION)

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
